<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- ================= HEADER ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#5A22D8"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:tint="#FFFFFF"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Digital Bus Pass"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="20sp"
            android:gravity="center"
            android:includeFontPadding="false"/>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_info_details"
            android:tint="#FFFFFF"/>

    </LinearLayout>


    <!-- ================= BLUE ROUTE CARD ================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="140dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="16dp"
        android:background="@drawable/blue_card">

        <!-- Bus Stop -->

        <TextView
            android:id="@+id/txtFromStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Thane Stn. E Kopari"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Direction -->

        <TextView
            android:id="@+id/txtDirection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⇄"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:includeFontPadding="true"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/txtFromStop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Destination -->

        <TextView
            android:id="@+id/txtToStop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TCS Olympus"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:includeFontPadding="true"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/txtDirection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Office Timing Row -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/txtToStop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Office In - 09:20"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:gravity="start|center_vertical"
                android:singleLine="true"
                android:ellipsize="end"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Office Out - 19:45"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:gravity="end|center_vertical"
                android:singleLine="true"
                android:ellipsize="end"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ================= PASS PAGES CONTAINER ================= -->

    <FrameLayout
        android:id="@+id/passContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- ================= QR PAGE ================= -->

        <LinearLayout
            android:id="@+id/qrLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Card + Green Corner Overlay -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- White QR Card -->

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/pass_card"
                    android:elevation="6dp"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/txtQrTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Confirmed Bus Pass"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#555555"
                        android:gravity="center"
                        android:layout_marginTop="5dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <View
                        android:id="@+id/dividerQr"
                        android:layout_width="0dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="12dp"
                        android:layerType="software"
                        android:background="@drawable/dotted_line"
                        app:layout_constraintTop_toBottomOf="@id/txtQrTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <ImageView
                        android:id="@+id/imgQR"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="16dp"
                        android:scaleType="fitCenter"
                        app:layout_constrainedWidth="true"
                        app:layout_constrainedHeight="true"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintTop_toBottomOf="@id/dividerQr"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Green Corner Overlay -->

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="top|start"
                    android:src="@drawable/green_corner"
                    android:scaleType="fitXY"
                    android:elevation="8dp"/>

            </FrameLayout>

            <!-- View Details Button -->

            <Button
                android:id="@+id/btnDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginTop="12dp"
                android:text="View Details"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#5520C9"/>

            <!-- TCS Logo -->

            <ImageView
                android:layout_width="180dp"
                android:layout_height="60dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:src="@drawable/tcs_logo"
                android:scaleType="fitCenter"/>

        </LinearLayout>


        <!-- ================= DETAILS PAGE ================= -->

        <LinearLayout
            android:id="@+id/detailsLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone">

            <!-- Card + Green Corner Overlay -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- White Details Card -->

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/pass_card"
                    android:elevation="2dp"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Confirmed Bus Pass"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="#555555"
                            android:gravity="center"
                            android:layout_marginTop="5dp"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:layout_marginTop="12dp"
                            android:layerType="software"
                            android:background="@drawable/dotted_line"/>

                        <!-- Row 1 -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:layout_marginTop="24dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Name"
                                    android:textColor="#888888"
                                    android:textSize="14sp"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="SURAJ GUPTA"
                                    android:textColor="#555555"
                                    android:textSize="16sp"
                                    android:layout_marginTop="6dp"/>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="end">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Employee ID"
                                    android:textColor="#888888"
                                    android:textSize="14sp"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="2919053"
                                    android:textColor="#555555"
                                    android:textSize="16sp"
                                    android:layout_marginTop="6dp"/>

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Row 2 -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:layout_marginTop="28dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Bus Stop Name"
                                    android:textColor="#888888"
                                    android:textSize="14sp"/>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Thane Stn. E Kopari"
                                    android:textColor="#555555"
                                    android:textSize="16sp"
                                    android:singleLine="true"
                                    android:ellipsize="end"
                                    android:layout_marginTop="6dp"/>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="end">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Route Type"
                                    android:textColor="#888888"
                                    android:textSize="14sp"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Both"
                                    android:textColor="#555555"
                                    android:textSize="16sp"
                                    android:layout_marginTop="6dp"/>

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Row 3 -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:layout_marginTop="28dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Start Date"
                                    android:textColor="#888888"
                                    android:textSize="14sp"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1st Sept, 2026"
                                    android:textColor="#555555"
                                    android:textSize="16sp"
                                    android:layout_marginTop="6dp"/>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="end">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="End Date"
                                    android:textColor="#888888"
                                    android:textSize="14sp"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="30th Sept, 2026"
                                    android:textColor="#555555"
                                    android:textSize="16sp"
                                    android:layout_marginTop="6dp"/>

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Route -->

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="42dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:gravity="center"
                            android:lineSpacingExtra="3dp"
                            android:text="Route : Thane Stn. E Kopari To TCS Olympus And Return Via-FAST"
                            android:textColor="#666666"
                            android:textSize="14sp"/>

                    </LinearLayout>

                </ScrollView>

                <!-- Green Corner Overlay -->

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="top|start"
                    android:src="@drawable/green_corner"
                    android:scaleType="fitXY"
                    android:elevation="8dp"/>

            </FrameLayout>

            <!-- View QR Button -->

            <Button
                android:id="@+id/btnQR"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginTop="12dp"
                android:text="View QR"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#5520C9"/>

            <!-- TCS Logo -->

            <ImageView
                android:layout_width="180dp"
                android:layout_height="60dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:src="@drawable/tcs_logo"
                android:scaleType="fitCenter"/>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>